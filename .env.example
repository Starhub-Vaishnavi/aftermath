# Optional. Without it, AFTERMATH produces deterministic graph-only explanations.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
AFTERMATH_MODEL=claude-opus-5-5
# Optional. When set, projects and investigations are stored in PostgreSQL.
# When unset, a local JSON file store under ./.data is used.
DATABASE_URL=
# Optional. Set all three to require "Sign in with GitHub"; projects and
# investigations then become private per user. Leave empty to keep the app open.
# AUTH_SECRET: any long random string, e.g. `openssl rand -base64 32`.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
